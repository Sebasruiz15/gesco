# Puerto donde corre el servidor Express
PORT=4000

# URL del frontend permitida por CORS
CORS_ORIGIN=http://localhost:5173

# A qué correo llegan los mensajes del formulario
CORREO_DESTINO=operaciones@gescocol.com

# Credenciales de Gmail para Nodemailer.
# GMAIL_USER: la cuenta de Gmail que envía los correos.
# GMAIL_APP_PASSWORD: NO es tu contraseña normal. Es una "contraseña de
# aplicación" de 16 dígitos. Para generarla:
#   1. Activa la verificación en 2 pasos en la cuenta de Gmail.
#   2. Ve a https://myaccount.google.com/apppasswords
#   3. Crea una contraseña de aplicación para "Correo" / "Otra (nombre personalizado)".
#   4. Pega aquí los 16 dígitos, sin espacios.
GMAIL_USER=tu-correo@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
